PORT=4600
# Public URL this service is reachable at once deployed (used as the OAuth
# redirect_uri and to build absolute redirect links). Must match exactly
# what you register with GitHub/Google below.
BROKER_PUBLIC_URL=https://broker.yourdomain.com

# Signs the short-lived state param carried through the OAuth round trip.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BROKER_JWT_SECRET=

# Set true only if you need to test with an http:// instance_callback
# (localhost) — never enable this in production.
BROKER_ALLOW_INSECURE_CALLBACKS=false

# ── GitHub OAuth App (github.com/settings/developers → New OAuth App) ──
# Authorization callback URL must be exactly ${BROKER_PUBLIC_URL}/github/callback
BROKER_GITHUB_CLIENT_ID=
BROKER_GITHUB_CLIENT_SECRET=

# ── Google OAuth Client (console.cloud.google.com → Credentials) ───────
# Authorized redirect URI must be exactly ${BROKER_PUBLIC_URL}/google/callback
BROKER_GOOGLE_CLIENT_ID=
BROKER_GOOGLE_CLIENT_SECRET=

# ── AI gateway passthrough ──────────────────────────────────────────────
# Your real upstream key (OpenAI, OpenRouter, etc.) — never exposed to
# instances, only used server-side here.
BROKER_AI_UPSTREAM_BASE_URL=https://api.openai.com/v1
BROKER_AI_UPSTREAM_KEY=
# ── Which gate the AI passthrough uses ─────────────────────────────────
# PREFERRED: per-account metering. The broker asks that instance's backend to
# reserve the calling account's credits before each call and reports the real
# token counts after it, so what limits spending is a balance rather than a
# secret you handed out. Set BOTH, where the instance URL is the instance's own
# https:// address reachable FROM this broker, and the secret is the instance's
# BROKER_INTERNAL_SECRET (it also needs BROKER_GATEWAY_SIGNING_SECRET set).
BROKER_METERING_INSTANCE_URL=
BROKER_METERING_SECRET=
# How long to wait on that instance before failing the call. It sits in the
# user's critical path, so it is deliberately short.
BROKER_METERING_TIMEOUT_MS=5000

# FALLBACK: shared deployment tokens, the original behaviour. Comma-separated
# values you hand out to instances (MORPHEUS_AI_GATEWAY_TOKEN on their side).
# Each one identifies a DEPLOYMENT, so this broker cannot tell whose account is
# spending — it is a stopgap for a broker you control, not a product.
#
# AN EMPTY LIST IS NOT "ALLOW EVERYONE" — with no tokens and no metering above,
# the gateway refuses every call. It used to accept any bearer token when this
# was empty, which left an operator's billed upstream key open to anyone who
# guessed the URL.
BROKER_AI_ALLOWED_TOKENS=
BROKER_AI_RATE_LIMIT_PER_MIN=30
