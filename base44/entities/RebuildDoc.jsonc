{
  "name": "RebuildDoc",
  "type": "object",
  "properties": {
    "version": {
      "type": "string"
    },
    "content": {
      "type": "string",
      "description": "Truncated preview of the rebuild blueprint. Full content is in file_url."
    },
    "content_size": {
      "type": "number",
      "default": 0
    },
    "file_url": {
      "type": "string",
      "description": "Storage URL for the full rebuild blueprint markdown file."
    }
  },
  "required": [
    "version"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}