{
  "name": "Project",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "init",
        "building",
        "ready"
      ],
      "default": "init"
    },
    "compile_target": {
      "type": "string",
      "enum": [
        "source",
        "windows-exe",
        "mac-app",
        "linux-binary",
        "android-apk",
        "ios-app",
        "python-package",
        "web-app",
        "rpi-distro",
        "linux-distro",
        "arduino-firmware"
      ],
      "default": "source"
    },
    "project_type": {
      "type": "string",
      "enum": [
        "frontend",
        "backend"
      ],
      "default": "frontend"
    },
    "polish_ui": {
      "type": "boolean",
      "default": false,
      "description": "When true, chatWithMorpheus runs an extra UI polish pass after the main build, refining only styling files."
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}