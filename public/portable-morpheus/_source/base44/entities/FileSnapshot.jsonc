{
  "name": "FileSnapshot",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "files": {
      "type": "string",
      "description": "Inline JSON of {path, content} for small snapshots. Large snapshots exceed the string-field limit and are stored in file_url instead, with a truncated preview kept here."
    },
    "file_url": {
      "type": "string",
      "description": "Storage URL for the full snapshot JSON when it exceeds the entity field size limit."
    }
  },
  "required": [
    "project_id",
    "label"
  ]
}