{
  "name": "Purchase",
  "type": "object",
  "properties": {
    "template_id": {
      "type": "string"
    },
    "template_name": {
      "type": "string"
    },
    "buyer_id": {
      "type": "string"
    },
    "buyer_email": {
      "type": "string"
    },
    "seller_id": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "platform_cut": {
      "type": "number",
      "default": 0
    },
    "seller_cut": {
      "type": "number",
      "default": 0
    },
    "stripe_session_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "paid",
        "refunded"
      ],
      "default": "paid"
    }
  },
  "required": [
    "template_id",
    "buyer_id",
    "amount"
  ]
}