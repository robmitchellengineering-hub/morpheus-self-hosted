{
  "name": "morpheus-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Morpheus self-hosted backend \u2014 Express + Prisma/Postgres. Ported 1:1 from the Base44 function/entity source (see PORTING_GUIDE.md).",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "dev:db": "node scripts/dev-db.mjs start",
    "dev:db:stop": "node scripts/dev-db.mjs stop",
    "dev:db:status": "node scripts/dev-db.mjs status",
    "dev:db:reset": "node scripts/dev-db.mjs reset",
    "dev:db:schema": "node scripts/dev-db.mjs schema",
    "start": "node src/index.js",
    "worker": "node src/worker.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.0",
    "@aws-sdk/lib-storage": "^3.1132.0",
    "@aws-sdk/s3-request-presigner": "^3.658.0",
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "esbuild": "^0.24.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonrepair": "^3.15.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "libsodium-wrappers": "^0.7.15",
    "mammoth": "^1.12.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.15",
    "pdf-parse": "^2.4.5",
    "puppeteer-core": "^25.11.0",
    "stripe": "^16.12.0",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17",
    "prisma": "^5.20.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
