# ── Core ──────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4500
# Comma-separated list of allowed frontend origins (CORS). Use * only for local dev.
CORS_ORIGIN=http://localhost:5173
# This backend's own publicly-reachable base URL — used to build OAuth
# broker-callback redirect URIs (see MORPHEUS_BROKER_URL below). Only
# needed if you're using the broker; defaults to the request's own
# host/protocol when unset, which is wrong behind most reverse proxies.
BACKEND_PUBLIC_URL=

# ── Morpheus Cloud defaults (optional) ─────────────────────────────
# Every connector below (GitHub, Google, AI) resolves in tiers: your own
# per-account key > this deployment's own credentials (further down this
# file) > these shared cloud defaults. Leave this blank to require your
# own credentials for everything — nothing here is required to run
# Morpheus. Set it to use github.com/<org>/morpheus's hosted broker (see
# hosted-broker/README.md), or deploy your own broker and point here.
MORPHEUS_BROKER_URL=
# Only needed if the AI gateway default should live on a different host
# than MORPHEUS_BROKER_URL. Usually leave unset — it reuses the broker.
MORPHEUS_AI_GATEWAY_URL=
# A per-deployment identifier the broker operator gives you — NOT a real
# OpenAI key. Required to use the AI gateway default even if
# MORPHEUS_BROKER_URL is set.
MORPHEUS_AI_GATEWAY_TOKEN=

# ── Database ──────────────────────────────────────────────────────
# For horizontal scaling, point this at PgBouncer (transaction pooling mode),
# not directly at Postgres. See SCALING.md.
DATABASE_URL=postgresql://morpheus:morpheus@localhost:5432/morpheus?schema=public

# ── Redis (sessions cache, rate limiting, BullMQ job queue) ────────
# Optional for a single-instance self-host; required to run server/src/worker.js
# and for multi-instance horizontal scaling.
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
# AES-256-GCM key (32 bytes, base64) used to encrypt secrets at rest
# (user AI/TTS API keys, GitHub tokens, backend API keys). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=change-me-32-byte-base64-key

# Google OAuth login (optional — falls back to MORPHEUS_BROKER_URL above if unset)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4500/api/auth/google/callback

# ── GitHub integration (per-user OAuth connector) ──────────────────
# Falls back to MORPHEUS_BROKER_URL above if unset.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:4500/api/connections/github/callback

# ── AI gateway — server-wide default, overridable per-user in Settings ─
# Works with OpenAI, OpenRouter, Together, Groq, Gemini, or any
# OpenAI-compatible endpoint (Ollama / LM Studio included). Falls back to
# MORPHEUS_AI_GATEWAY_URL/MORPHEUS_BROKER_URL above if LLM_API_KEY is unset.
# Recommended free-tier default: Google Gemini via its OpenAI-compatible
# endpoint. Get a key at https://aistudio.google.com/apikey
#
# LLM_MODEL=gemini-flash-latest uses Google's own self-updating alias —
# it always points at their newest Flash release (hot-swapped server-side,
# 2-week email notice first), so you never need to bump a version string
# by hand. Leaving LLM_MODEL blank, "auto", or "latest" does the same
# thing for ANY OpenAI-compatible endpoint, not just Gemini — server/src/
# ai.js queries that endpoint's own /models list and picks the newest chat
# model when there's no official "-latest" alias to use instead. Pin an
# exact version (e.g. gemini-3.6-flash) only if you want behavior to stay
# fixed even when the provider ships a new model — see
# https://ai.google.dev/gemini-api/docs/models for current Gemini IDs.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-flash-latest

# ── Platform freshness (self-check, not self-modifying) ────────────────
# On a schedule, Morpheus checks whether its own AI model config has
# drifted behind the newest available model, and whether server/ or the
# frontend have outdated npm dependencies — then emails a summary if
# anything's worth reviewing. It never edits package.json or auto-installs
# anything; see server/src/freshness.js and FRESHNESS.md for the design
# reasoning. Also readable any time at GET /api/admin/freshness (admin
# JWT required). Runs in-process (no Redis needed) on a single-instance
# self-host; with REDIS_URL set, runs once via the worker process instead
# of once per API replica — see server/src/worker.js.
FRESHNESS_CHECK_ENABLED=true
# How often to check, in ms. Default 86400000 (24h).
FRESHNESS_CHECK_INTERVAL_MS=
# Who gets the "N item(s) worth reviewing" email. Falls back to SMTP_USER;
# leave both unset to disable email (the check still runs and is still
# readable via the API above).
FRESHNESS_NOTIFY_EMAIL=
LLM_PLANNER_MODEL=
LLM_CODER_MODEL=
LLM_REVIEWER_MODEL=
LLM_DIAGNOSIS_MODEL=

# ── Stripe (marketplace) ────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
MARKETPLACE_PLATFORM_CUT_PCT=20

# ── Object storage (S3-compatible: AWS S3, Cloudflare R2, MinIO, B2) ──
# When unset, files fall back to local disk under server/data/storage —
# fine for a single-instance self-host, NOT fine for horizontal scaling
# (every instance needs the same view of stored files).
STORAGE_DRIVER=local              # local | s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=morpheus
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ── Email (account emails, project export, compile-complete notices) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Morpheus <no-reply@yourdomain.com>"

# ── Compile pipeline ─────────────────────────────────────────────────
# GitHub App/OAuth token scope 'repo' is used to create build repos under
# the operator's own account and push generated GitHub Actions workflows.
COMPILE_BUILD_REPO_PREFIX=morpheus-build-

# ── TTS (optional; browser speechSynthesis is the zero-cost default) ──
TTS_ENGINE=
TTS_API_KEY=
