# ── Core ──────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4500
# Comma-separated list of allowed frontend origins (CORS). Use * only for local dev.
CORS_ORIGIN=http://localhost:5173
# This backend's own publicly-reachable base URL — used to build OAuth
# broker-callback redirect URIs (see MORPHEUS_BROKER_URL below). Only
# needed if you're using the broker; defaults to the request's own
# host/protocol when unset, which is wrong behind most reverse proxies.
BACKEND_PUBLIC_URL=

# ── Morpheus Cloud defaults (optional) ─────────────────────────────
# Every connector below (GitHub, Google, AI) resolves in tiers: your own
# per-account key > this deployment's own credentials (further down this
# file) > these shared cloud defaults. Leave this blank to require your
# own credentials for everything — nothing here is required to run
# Morpheus. Set it to use github.com/<org>/morpheus's hosted broker (see
# hosted-broker/README.md), or deploy your own broker and point here.
MORPHEUS_BROKER_URL=
# Only needed if the AI gateway default should live on a different host
# than MORPHEUS_BROKER_URL. Usually leave unset — it reuses the broker.
MORPHEUS_AI_GATEWAY_URL=
# A per-deployment identifier the broker operator gives you — NOT a real
# OpenAI key. Required to use the AI gateway default even if
# MORPHEUS_BROKER_URL is set.
MORPHEUS_AI_GATEWAY_TOKEN=

# ── Database ──────────────────────────────────────────────────────
# For horizontal scaling, point this at PgBouncer (transaction pooling mode),
# not directly at Postgres. See SCALING.md.
DATABASE_URL=postgresql://morpheus:morpheus@localhost:5432/morpheus?schema=public

# ── Redis (sessions cache, rate limiting, BullMQ job queue) ────────
# Optional for a single-instance self-host; required to run server/src/worker.js
# and for multi-instance horizontal scaling.
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
# AES-256-GCM key (32 bytes, base64) used to encrypt secrets at rest
# (user AI/TTS API keys, GitHub tokens, backend API keys). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=change-me-32-byte-base64-key

# Google OAuth login (optional — falls back to MORPHEUS_BROKER_URL above if unset)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4500/api/auth/google/callback

# ── GitHub integration (per-user OAuth connector) ──────────────────
# Falls back to MORPHEUS_BROKER_URL above if unset.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:4500/api/connections/github/callback

# ── AI gateway — server-wide default, overridable per-user in Settings ─
# Works with OpenAI, OpenRouter, Together, Groq, DeepSeek, Gemini, Moonshot
# (Kimi K3, model id "kimi-k3", base URL https://api.moonshot.ai/v1), or any
# OpenAI-compatible endpoint (Ollama / LM Studio included). Falls back to
# MORPHEUS_AI_GATEWAY_URL/MORPHEUS_BROKER_URL above if LLM_API_KEY is unset.
#
# TOKEN-SYSTEM-BUILD-PLAN.md's pricing model (2026-08-31): no free tier —
# this key is the paid pay-as-you-go default, billed to users in credits
# (server/src/lib/billing.js, already enforced on every call regardless of
# provider). DeepSeek is the recommended default for exactly that reason:
# cheap frontier pricing, real prepaid-balance billing that scales with
# actual paid usage. Get a key + add balance at https://platform.deepseek.com
# Do NOT point this at a personal/shared free-tier key (e.g. a personal
# Gemini API key) — every user on this deployment shares whatever's here,
# so a free-tier key becomes one shared rate limit everyone congests on
# (this was Morpheus's own Gemini-503 bug). A user who wants a genuinely
# free path uses their own key via Settings → AI Provider (BYOK) instead —
# that's a per-account override (ai.js tier 1), never billed against this
# platform key.
#
# LLM_MODEL=deepseek-v4-flash is DeepSeek's cheap frontier model, the
# reference point TOKEN-SYSTEM-BUILD-PLAN.md's per-user cost figures were
# built against. Leaving LLM_MODEL blank, "auto", or "latest" queries the
# endpoint's own /models list and picks the newest chat model when there's
# no official "-latest" alias — works for any OpenAI-compatible endpoint,
# not just this one.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash

# ── DeepSeek balance safeguard (Token System Build Plan Step 6b) ──────
# DeepSeek bills off a prepaid balance; hitting zero fails every AI call
# platform-wide at once (see server/src/lib/deepseekBalance.js). Only does
# anything when LLM_BASE_URL above is DeepSeek's — inert otherwise.
# FALLBACK_LLM_* is the emergency-only provider automatically used while
# the primary balance is depleted (a personal/free Gemini key is a
# reasonable choice here specifically, since fallback traffic is meant to
# be occasional and short-lived, not the everyday default this key used to
# be). Automated top-up is NOT built — recharging is a real financial
# transaction and stays a human action at platform.deepseek.com/top_up;
# this only monitors, alerts, and fails over.
FALLBACK_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=gemini-flash-latest
# Warning-threshold balance (USD) is admin-editable in-product (Admin Panel
# → Config, key: deepseek_balance_min_usd) — defaults to $10 if unset there.
# Who gets alert emails when balance runs low or hits zero. Falls back to
# FRESHNESS_NOTIFY_EMAIL, then SMTP_USER. An in-product alert always lands
# in the Admin Panel's Audit Log regardless of whether email is configured.
DEEPSEEK_ALERT_EMAIL=
# How often to check, in ms. Default 900000 (15m) — a balance can move
# fast under real paid load, unlike the 24h freshness check.
DEEPSEEK_BALANCE_CHECK_INTERVAL_MS=
DEEPSEEK_BALANCE_CHECK_ENABLED=true

# ── Platform freshness (self-check, not self-modifying) ────────────────
# On a schedule, Morpheus checks whether its own AI model config has
# drifted behind the newest available model, and whether server/ or the
# frontend have outdated npm dependencies — then emails a summary if
# anything's worth reviewing. It never edits package.json or auto-installs
# anything; see server/src/freshness.js and FRESHNESS.md for the design
# reasoning. Also readable any time at GET /api/admin/freshness (admin
# JWT required). Runs in-process (no Redis needed) on a single-instance
# self-host; with REDIS_URL set, runs once via the worker process instead
# of once per API replica — see server/src/worker.js.
FRESHNESS_CHECK_ENABLED=true
# How often to check, in ms. Default 86400000 (24h).
FRESHNESS_CHECK_INTERVAL_MS=
# Who gets the "N item(s) worth reviewing" email. Falls back to SMTP_USER;
# leave both unset to disable email (the check still runs and is still
# readable via the API above).
FRESHNESS_NOTIFY_EMAIL=
LLM_PLANNER_MODEL=
LLM_CODER_MODEL=
LLM_REVIEWER_MODEL=
LLM_DIAGNOSIS_MODEL=

# ── Web research ─────────────────────────────────────────────────────
# The WEB toggle in the chat panel lets Morpheus search the web and read
# pasted URLs before answering — for current library/API versions, best
# practices, or docs the project files can't contain. NOTHING TO CONFIGURE:
# Wikipedia, arXiv, /llms.txt and direct page fetches all work with no key.
# Google-grounded web search is added automatically when a Gemini key is
# available — either the calling user's own Settings AI key (if it points at
# generativelanguage.googleapis.com) or this deployment's FALLBACK_LLM_* key
# below. Gemini grounding is ~5,000 free grounded queries/month per key.

# ── Ops Console (2026-09-02) — Northflank integration ─────────────────
# Lets the Admin Ops Console + Self-Dev's OPS panel pull this deployment's
# own runtime logs and deploy status directly — no separate Northflank tab
# needed to see what broke. Read scope alone is enough for that: create a
# token at Team Settings -> API -> Tokens with an RBAC role granting
# "View Services" + "View Observability" on this project only. Leave blank
# to disable the panel (it degrades to a clear "not connected" message).
NORTHFLANK_API_TOKEN=
# Opt-in for the OPS panel's RESTART SERVICE button (rolling restart of the
# backend containers, same build). Only honoured when set to exactly "true"
# AND the token above also has "Services > General > Update" scope. Off by
# default so "read the logs" and "restart production" stay separate calls.
NORTHFLANK_WRITE_ENABLED=
# Defaults match this project's own known Northflank project/service names
# -- override only if you've forked/self-hosted under different ones.
NORTHFLANK_PROJECT_ID=morpheus-self-hosted
NORTHFLANK_SERVICE_ID=morpheus-backend

# ── Stripe (marketplace) ────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
MARKETPLACE_PLATFORM_CUT_PCT=20

# ── Object storage (S3-compatible: AWS S3, Cloudflare R2, MinIO, B2) ──
# When unset, files fall back to local disk under server/data/storage —
# fine for a single-instance self-host, NOT fine for horizontal scaling
# (every instance needs the same view of stored files).
STORAGE_DRIVER=local              # local | s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=morpheus
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ── Email (account emails, project export, compile-complete notices) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Morpheus <no-reply@yourdomain.com>"

# ── Compile pipeline ─────────────────────────────────────────────────
# GitHub App/OAuth token scope 'repo' is used to create build repos under
# the operator's own account and push generated GitHub Actions workflows.
COMPILE_BUILD_REPO_PREFIX=morpheus-build-

# ── TTS (optional; browser speechSynthesis is the zero-cost default) ──
TTS_ENGINE=
TTS_API_KEY=
