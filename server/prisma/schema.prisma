// Morpheus — self-hosted Postgres schema (Prisma)
//
// Field names deliberately mirror the original Base44 entity schemas
// (base44/entities/*.jsonc in the project source) — snake_case, same
// property names — so the 34 ported function handlers and the existing
// React frontend (which already reads fields like `project.compile_target`,
// `file.project_id`, `msg.role`) needed no field-name translation layer.
//
// Every entity carries id / created_by_id / created_date / updated_date,
// matching Base44's implicit row metadata and its row-level-security model
// (RLS keyed on created_by_id, replicated in src/entities.js).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── USERS & SETTINGS ─────────────────────────────────────────────

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password_hash String
  full_name     String?
  role          String   @default("user") // user | admin
  google_id     String?  @unique
  email_verified Boolean @default(false)
  otp_code      String?
  otp_expires   DateTime?
  created_date  DateTime @default(now())
  updated_date  DateTime @updatedAt

  // Token System Build Plan Step 1: every new account starts with 200 free
  // signup credits, usable on Default mode with zero setup.
  // Step 3 (2026-09-01, see lib/billing.js): pre-call reserve + reconcile
  // enforcement now actually spends this. Decimal, not Int -- at $0.005/credit
  // (the decided $5-per-1,000-credits rate) a single cheap chat turn can cost
  // a fraction of a credit, and rounding that to 0 would silently undercharge.
  // Scale 4 gives resolution far finer than any real per-call cost. Billing
  // exemption for admins reuses the existing `role` column above (role ===
  // 'admin').
  credit_balance  Decimal  @default(200) @db.Decimal(14, 4)

  // Free-usage grant, separate from `role` (2026-09-12, Rob: wanted a way to
  // give someone free usage "withought giving full admin access" — role
  // === 'admin' was this app's only billing exemption until now, but it
  // also grants the full Admin Panel). Checked alongside role in ai.js's
  // isExempt logic; grants no other admin capability anywhere.
  billing_exempt  Boolean  @default(false)

  projects        Project[]
  project_files   ProjectFile[]
  chat_messages   ChatMessage[]
  file_snapshots  FileSnapshot[]
  usage_records   UsageRecord[]
  usage_events    UsageEvent[]
  credit_transactions CreditTransaction[]
  templates       Template[]
  purchases       Purchase[]
  settings        UserSettings?
  backend_configs BackendConfig[]
  rebuild_docs    RebuildDoc[]
  updates_plans   UpdatesPlan[]
  cost_snapshots  CostSnapshot[]
  self_dev_manuals SelfDevManual[]
  self_dev_features SelfDevFeature[]
  self_dev_decisions SelfDevDecision[]
  project_assets   ProjectAsset[]
  plugin_connections PluginConnection[]
  widget_tokens    WidgetToken[]
  device_tokens    DeviceToken[]
  github_connection GithubConnection?

  // Owner/Admin Control Panel (Feature Backlog #8)
  platform_settings_updated PlatformSetting[]
  admin_audit_logs          AdminAuditLog[]
  maintenance_tasks         MaintenanceTask[]

  @@map("users")
}

model UserSettings {
  id             String   @id @default(uuid())
  created_by_id  String   @unique
  user           User     @relation(fields: [created_by_id], references: [id], onDelete: Cascade)

  ai_mode        String   @default("default") // default | custom
  ai_base_url    String?
  ai_api_key     String?  // encrypted at rest (src/crypto.js)
  ai_model       String?
  planner_model  String?
  coder_model    String?
  reviewer_model String?
  diagnosis_model String?

  connections    String?  // JSON string: hosting platform credentials, encrypted at rest

  tts_mode       String   @default("default")
  tts_engine     String   @default("elevenlabs")
  tts_api_key    String?  // encrypted at rest
  tts_voice_id   String?
  tts_endpoint   String?

  // Settings → Appearance "Personality" toggle (2026-09-02). When true
  // (default), Morpheus's Matrix-mentor voice/metaphors are in the system
  // prompt as usual. When false, chatWithMorpheus.js swaps in a plain,
  // no-roleplay system prompt instead -- same technical rules and build
  // instructions, just no character voice. See SYSTEM_PROMPT_PLAIN there.
  personality_enabled Boolean @default(true)

  created_date   DateTime @default(now())
  updated_date   DateTime @updatedAt

  @@map("user_settings")
}

model GithubConnection {
  id            String   @id @default(uuid())
  created_by_id String   @unique
  user          User     @relation(fields: [created_by_id], references: [id], onDelete: Cascade)
  login         String
  access_token  String   // encrypted at rest
  scope         String?

  // Only populated when the GitHub OAuth App has its "Token expiration"
  // optional feature turned on (8hr access tokens + refresh tokens). All
  // three are null for a connection made while that feature is off, since
  // GitHub's token exchange then returns a non-expiring access_token with
  // no refresh_token at all. See lib/github.js's getGithubConnection for
  // the silent-refresh logic that uses these.
  refresh_token             String?  // encrypted at rest
  expires_at                DateTime?
  refresh_token_expires_at  DateTime?

  created_date  DateTime @default(now())

  @@map("github_connections")
}

// ── PROJECTS ──────────────────────────────────────────────────────

model Project {
  id             String   @id @default(uuid())
  created_by_id  String
  owner          User     @relation(fields: [created_by_id], references: [id], onDelete: Cascade)

  name           String
  description    String?
  status         String   @default("init")       // init | building | ready
  compile_target String   @default("source")      // source|windows-exe|mac-app|linux-binary|android-apk|ios-app|python-package|web-app|rpi-distro|linux-distro|arduino-firmware
  project_type   String   @default("frontend")    // frontend | backend
  polish_ui      Boolean  @default(false)

  // Rolling "critical logic" memory for long-lived projects — see
  // lib/contextSummary.js. Chat history sent to the AI is bounded to the
  // last 20/10 messages (matches the original app; see the 2026-08-26
  // audit for why unbounded history was reverted), so this periodically-
  // updated, compressed summary of everything older than that window is
  // what keeps requirements/decisions from a project's early messages from
  // being silently forgotten once it runs long. context_summary_message_count
  // tracks how many messages have been folded in so far, so the next
  // update knows where to resume.
  context_summary               String? @db.Text
  context_summary_message_count Int     @default(0)

  // "owner/repo" of the GitHub repo this project is connected to — set by
  // uploadToGithub.js / importFromGithub.js. Media Library's "add from
  // device" commits assets straight into this repo (public/assets/*), and
  // it's where a static site actually gets deployed from.
  github_repo    String?
  // Optional per-construct GitHub token (encrypted at rest, src/crypto.js).
  // For client work: when the client's repo isn't covered by the owner's
  // global GitHub connection, they hand over a fine-grained PAT scoped to
  // that one repo and it's stored here. getGithubToken(userId, {projectId})
  // prefers this over the global connection.
  github_token   String?  @db.Text

  files          ProjectFile[]
  chat_messages  ChatMessage[]
  snapshots      FileSnapshot[]
  usage_records  UsageRecord[]
  templates      Template[]
  backend_config BackendConfig?
  self_dev_features SelfDevFeature[]
  self_dev_decisions SelfDevDecision[]
  assets         ProjectAsset[]
  plugin_connections PluginConnection[]
  widget_tokens  WidgetToken[]

  created_date   DateTime @default(now())
  updated_date   DateTime @updatedAt

  @@map("projects")
}

model ProjectFile {
  id            String   @id @default(uuid())
  created_by_id String
  user          User     @relation(fields: [created_by_id], references: [id], onDelete: Cascade)
  project_id    String
  project       Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)

  path          String
  content       String   @db.Text
  file_url      String?  // storage URL for large/binary files; content holds a text preview only
  language      String   @default("text")

  created_date  DateTime @default(now())
  updated_date  DateTime @updatedAt

  @@unique([project_id, path])
  @@map("project_files")
}

model ChatMessage {
  id            String   @id @default(uuid())
  created_by_id String
  user          User     @relation(fields: [created_by_id], references: [id], onDelete: Cascade)
  project_id    String
  project       Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)

  role          String   // user | morpheus
  content       String   @db.Text

  created_date  DateTime @default(now())

  @@map("chat_messages")
}

model FileSnapshot {
  id            String   @id @default(uuid())
  created_by_id String
  user          User     @relation(fields: [created_by_id], references: [id], onDelete: Cascade)
  project_id    String
  project       Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)

  label         String?
  files         String?  @db.Text // inline JSON preview; full snapshot offloaded to file_url when large
  file_url      String?

  created_date  DateTime @default(now())

  @@map("file_snapshots")
}

// ── USAGE ─────────────────────────────────────────────────────────

model UsageRecord {
  id            String   @id @default(uuid())
  created_by_id String
  user          User     @relation(fields: [created_by_id], references: [id], onDelete: Cascade)

  action_type   String   // chat_build | chat_simple | autonomous_step | compile | diagnosis | ...
  credits       Int      @default(1)
  project_id    String?
  project       Project? @relation(fields: [project_id], references: [id], onDelete: SetNull)
  project_name  String?
  metadata      String?  @db.Text

  created_date  DateTime @default(now())

  @@map("usage_records")
}

// ── TOKEN SYSTEM / BILLING METERING ─────────────────────────────────
// TOKEN-SYSTEM-BUILD-PLAN.md Step 1 (schema) + Step 2 (real metering).
// UsageRecord above is the older, bucketed-*estimate* credit-cost log
// (lib/costEstimate.js's static per-action-type token guesses) that already
// drives the existing Cost Tracker page -- left in place, unchanged.
// UsageEvent below is new: one row per actual AI call, with real token
// counts from the provider's own response, logged directly inside
// invokeAI() (server/src/ai.js) so every caller gets metering for free.
// Deliberately NOT wired to any credit deduction yet -- credits_charged
// stays 0 until Step 3 (pre-call reserve/reconcile enforcement) is built;
// this step only makes usage data honest, it doesn't change what anyone
// experiences.

model UsageEvent {
  id              String   @id @default(uuid())
  created_by_id   String
  user            User     @relation(fields: [created_by_id], references: [id], onDelete: Cascade)

  role            String?  // planner | coder | reviewer | diagnosis | null for role-less calls
  provider        String   // platform | custom | morpheus-cloud | unconfigured
  model_id        String   // the resolved model actually used (post alias-resolution)

  input_tokens    Int      @default(0)
  output_tokens   Int      @default(0)
  cost_usd        Float    @default(0) // underlying provider cost, computed from real token counts
  // Retail credits actually deducted for this call (0 for exempt/admin
  // accounts -- exempt means "don't charge," not "don't meter", see
  // lib/billing.js). Decimal to match User.credit_balance's precision.
  credits_charged Decimal  @default(0) @db.Decimal(14, 4)

  project_id      String?  // best-effort correlation only, not a hard FK -- not every
                            // invokeAI() call site has a project in scope (e.g. Architect)

  created_date    DateTime @default(now())

  @@index([created_by_id])
  @@map("usage_events")
}

// Admin-editable per-model $/M-token pricing + markup multiplier. Genuinely
// new -- TOKEN-SYSTEM-BUILD-PLAN.md describes a table like this as "already
// exists, built for the self-updating model/pricing research system," but
// no such table or system exists anywhere in this codebase (grepped clean);
// most likely a stale assumption carried over from earlier planning. This
// table is what Step 4's admin pricing UI (not yet built) will edit; until
// populated, getModelRate() in lib/modelPricing.js falls back to the
// existing static MODEL_PRICING table in lib/costEstimate.js.
model ModelCatalogEntry {
  id                 String   @id @default(uuid())
  model_id           String   @unique
  provider           String?  // openai | deepseek | gemini | anthropic | custom | ...
  input_price_per_m  Float?   // $ per 1M input tokens; null = use costEstimate.js fallback
  output_price_per_m Float?   // $ per 1M output tokens
  markup_multiplier  Float    @default(2.0) // admin-editable; 2.0 = flat 2x, BUSINESS-STRATEGY.md default
  active             Boolean  @default(true)

  created_date       DateTime @default(now())
  updated_date       DateTime @updatedAt

  @@map("model_catalog_entries")
}

// Token-block purchases (one-off Stripe Checkout -- no subscriptions, per
// the decided access model). Not wired to any purchase UI yet (Step 6, not
// built) -- the table exists now so this migration doesn't need a follow-up
// once that ships, and so the $1 signup-credit recoup gross-up (charged
// into a user's first real purchase) has somewhere to record itself.
//
// Block denominations decided 2026-09-01 (see lib/billing.js's TOKEN_BLOCKS
// for the full worked-out numbers): $1.87 / $5 / $10 intended net value ->
// 374 / 1,000 / 2,000 credits at the $5-per-1,000 rate, Stripe-fee-grossed-up
// to $2.23 / $5.46 / $10.61 actually charged. Not yet wired to a purchase
// route -- Step 6 (frontend + Checkout) still needs building.
model CreditTransaction {
  id                 String   @id @default(uuid())
  created_by_id      String
  user               User     @relation(fields: [created_by_id], references: [id], onDelete: Cascade)

  credits            Decimal  @db.Decimal(14, 4) // credits granted by this transaction
  amount_usd         Float    @default(0) // what the customer was actually charged (post Stripe-fee gross-up)
  intended_net_usd   Float    @default(0) // the block's face value before the fee gross-up
  stripe_session_id  String?  @unique
  status             String   @default("paid") // paid | refunded
  is_first_purchase  Boolean  @default(false) // true if the signup-credit recoup gross-up applied

  created_date       DateTime @default(now())

  @@map("credit_transactions")
}

// ── OWNER/ADMIN CONTROL PANEL (Feature Backlog #8) ──────────────────
// Access control decision (2026-09-01): role column, not a hardcoded email
// -- reuses the User.role 'admin' value that already gates self-dev and
// synthesizeUpdatesPlan (see auth.js's requireAdmin + functions.routes.js's
// ADMIN_FUNCTIONS set), rather than introducing a separate 'owner' tier.
// Auth hardening decision: role-gated only for v1 (same bar as the existing
// admin surfaces) -- no additional step-up auth yet; revisit if this ever
// needs to protect more than one admin account.

// Generic admin-editable key/value store, read with a short in-memory cache
// (see lib/platformSettings.js) so hot paths like invokeAI() never take a
// DB round-trip on every call. Flagship use: default_<role>_model /
// default_model keys let ai.js's resolveEndpoint() pick a platform-wide
// default model without a code deploy -- see ai.js for exactly where this
// sits in the existing env-var/per-user-setting priority chain (additive
// only; an empty table changes nothing). Also the general-purpose home for
// any future admin-editable flag ("General config/feature flags" in the
// backlog) -- not every key written here necessarily has a live consumer
// yet, same as an unused env var.
model PlatformSetting {
  key           String   @id
  value         String
  updated_by_id String?
  updated_by    User?    @relation(fields: [updated_by_id], references: [id], onDelete: SetNull)
  updated_date  DateTime @updatedAt

  @@map("platform_settings")
}

// Every change made through the admin panel (model routing swaps, model
// catalog/pricing edits, other settings) gets one row here -- decided
// 2026-09-01: log everything, since audit trail is cheap now and far more
// valuable to have from day one than to bolt on later once there's
// financial/model-routing history worth reconstructing. Deliberately not
// exposed through the generic entity CRUD engine (server/src/entities.js)
// -- an audit log that its own subject can edit or delete isn't much of an
// audit log -- so this is written only from admin.routes.js's own handlers
// and read via a dedicated GET endpoint.
model AdminAuditLog {
  id           String   @id @default(uuid())
  admin_id     String?
  admin        User?    @relation(fields: [admin_id], references: [id], onDelete: SetNull)
  action       String   // e.g. 'update_setting', 'update_model_catalog'
  details      String?  @db.Text // JSON-stringified {key, oldValue, newValue} or similar
  created_date DateTime @default(now())

  @@map("admin_audit_log")
}

// Lightweight ops checklist -- the "Maintenance punch-list" surface from the
// backlog (rotating credentials, clearing stale GitHub PATs, pending
// migrations, etc.) that's been happening ad hoc up to this session. Low-
// stakes enough (ticking off a to-do) that it goes through the existing
// generic entity CRUD engine like any other owner-scoped entity, rather
// than bespoke admin.routes.js handlers -- entities.js's scope() already
// gives admins unrestricted access with no owner filter.
model MaintenanceTask {
  id            String   @id @default(uuid())
  created_by_id String
  user          User     @relation(fields: [created_by_id], references: [id], onDelete: Cascade)

  title         String
  done          Boolean  @default(false)

  created_date  DateTime @default(now())
  updated_date  DateTime @updatedAt

  @@map("maintenance_tasks")
}

// ── MARKETPLACE ───────────────────────────────────────────────────

model Template {
  id                String     @id @default(uuid())
  created_by_id     String
  author            User       @relation(fields: [created_by_id], references: [id], onDelete: Cascade)
  project_id        String?
  project           Project?   @relation(fields: [project_id], references: [id], onDelete: SetNull)

  name              String
  description       String?
  long_description  String?    @db.Text
  author_name       String?
  author_id         String?
  files             String     @db.Text // full project files JSON at publish time
  artifact_files    String?    @db.Text // optional JSON array of [{name, file_url}] —
                                         // compiled binaries (apk/exe/etc.) a seller chose
                                         // to attach alongside the source in `files`, pulled
                                         // from the project's own `_compiled/` ProjectFile
                                         // rows at publish time. Null/empty = source only.
  icon              String?
  screenshots       String?    @db.Text // JSON array of URLs
  compile_target    String     @default("source")
  tags              String?    // comma-separated
  category          String     @default("general")
  install_count     Int        @default(0)
  file_count        Int        @default(0)
  price             Float      @default(0) // dollars (e.g. 9.99), same convention as
                                            // the original Base44 Template entity; 0 = free
  stripe_product_id String?
  stripe_price_id   String?

  purchases         Purchase[]

  created_date      DateTime   @default(now())
  updated_date      DateTime   @updatedAt

  @@map("templates")
}

model Purchase {
  id                 String   @id @default(uuid())
  created_by_id      String
  buyer              User     @relation(fields: [created_by_id], references: [id], onDelete: Cascade)

  // Nullable + SetNull (not Cascade): matches the original's behavior of a
  // seller deleting their account removing their Templates but leaving
  // buyers' own Purchase/receipt records intact (just orphaned from the
  // template row) rather than destroying other customers' purchase history.
  template_id        String?
  template            Template? @relation(fields: [template_id], references: [id], onDelete: SetNull)
  template_name      String?
  buyer_id           String
  buyer_email        String?
  seller_id          String
  amount             Float    @default(0) // dollars, same convention as the original
  platform_cut       Float    @default(0)
  seller_cut         Float    @default(0)
  stripe_session_id  String   @unique
  status             String   @default("paid") // paid | refunded

  created_date       DateTime @default(now())

  @@map("purchases")
}

// One-off "keep the lights on" donations from the landing page — deliberately
// NOT tied to a User (base44's donate widget works for anonymous, pre-login
// visitors, and this mirrors that). Recorded by stripeWebhook.js's
// metadata.type === 'donation' branch, separately from Purchase so donation
// totals never get mixed into marketplace sales/payout reporting.
model Donation {
  id                String   @id @default(uuid())
  amount            Float    @default(0) // dollars
  donor_email       String?
  stripe_session_id String   @unique
  status            String   @default("paid") // paid | refunded

  created_date      DateTime @default(now())

  @@map("donations")
}

// Landing page's public "SUGGEST AN IMPROVEMENT" box — no login required,
// same as base44's version. Deliberately not tied to a User for the same
// reason Donation isn't: anonymous, pre-login visitors can submit these.
// Feeds base44's admin-only "Morpheus Updates Plan" AI synthesis tool,
// which isn't built yet on the self-hosted side — this table is the
// prerequisite for it.
model Feedback {
  id           String   @id @default(uuid())
  type         String   @default("feature") // feature | bug
  message      String   @db.Text
  email        String?
  status       String   @default("new") // new | reviewed | actioned

  created_date DateTime @default(now())

  @@map("feedback")
}

// ── BACKEND ARCHITECT ────────────────────────────────────────────

model BackendConfig {
  id            String   @id @default(uuid())
  created_by_id String
  user          User     @relation(fields: [created_by_id], references: [id], onDelete: Cascade)
  project_id    String   @unique
  project       Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)

  custom_domain String?
  api_keys      String?  @db.Text // JSON array, encrypted at rest
  deploy_platform String?
  deploy_url    String?
  deploy_status String?

  created_date  DateTime @default(now())
  updated_date  DateTime @updatedAt

  @@map("backend_configs")
}

// ── DOCS ──────────────────────────────────────────────────────────

model RebuildDoc {
  id              String   @id @default(uuid())
  created_by_id   String
  user            User     @relation(fields: [created_by_id], references: [id], onDelete: Cascade)

  version         String
  content         String   @db.Text // truncated preview
  content_size    Int      @default(0)
  file_url        String?

  created_date    DateTime @default(now())
  updated_date    DateTime @updatedAt

  @@map("rebuild_docs")
}

// "SELF-DEV & ADMIN MANUAL" — an AI-written operator's guide to running
// Morpheus through the Self-Dev workspace and Admin Control Panel (Rob,
// 2026-09-03: "give me a manual... that gets updated when anything to do
// with self dev or admin get updated"). Unlike RebuildDoc above (a static,
// hand-authored architecture dump), generateSelfDevManual.js reads the
// ACTUAL CURRENT SOURCE of the self-dev/admin-relevant files and has an LLM
// write the manual from them each time — so "updated when the code changes"
// is true by construction rather than something a human has to remember to
// edit. version/content/content_size/file_url mirror RebuildDoc's
// single-row-per-admin upsert pattern exactly (see generateRebuildDoc.js).
// trigger records why the last regeneration happened ('manual' — the admin
// clicked REGENERATE, or 'auto:push' — pushSelfDevToGithub.js detected the
// push touched one of the source files this doc is built from and
// regenerated automatically, with no button click needed). source_hash is a
// hash of the concatenated source files at generation time, kept so the UI
// can show whether the current doc still matches the latest self-dev
// push without re-running the (costly) LLM call just to check.
model SelfDevManual {
  id              String   @id @default(uuid())
  created_by_id   String
  user            User     @relation(fields: [created_by_id], references: [id], onDelete: Cascade)

  version         String
  content         String   @db.Text // truncated preview
  content_size    Int      @default(0)
  file_url        String?
  trigger         String?  // 'manual' | 'auto:push'
  source_hash     String?

  created_date    DateTime @default(now())
  updated_date    DateTime @updatedAt

  @@map("self_dev_manuals")
}

// Persistent multi-step feature plan for self-dev (SELF-DEV-V2 A1). A real
// feature ("add project comments") spans several self-dev turns — schema +
// routes + function + components + wiring. Without this, every turn re-derives
// intent from one message and can contradict an earlier step. One `active`
// feature per self-dev project at a time; chatWithMorpheus.js gives the planner
// the goal + step list + which step is active on every build turn, and the
// operator marks a step done from the FEATURE panel (planSelfDevFeature.js /
// updateSelfDevFeature.js). `steps` is a JSON string (the codebase stores
// structured data as Text, not Prisma Json — see Project.context_summary):
//   [{ n, title, status: 'pending'|'active'|'done', ref?, note? }]
model SelfDevFeature {
  id            String   @id @default(uuid())
  created_by_id String
  user          User     @relation(fields: [created_by_id], references: [id], onDelete: Cascade)
  project_id    String
  project       Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)

  title         String
  goal          String   @db.Text
  steps         String   @db.Text
  status        String   @default("active") // active | done | abandoned

  created_date  DateTime @default(now())
  updated_date  DateTime @updatedAt

  @@map("self_dev_features")
}

// Decisions log for self-dev (Command Deck Tier 2 #7). After every self-dev
// change that ships, the planner's one-line "what changed / why" is recorded
// here, and the last ~8 entries are fed back into the planner's context on the
// next build turn — so it builds on past decisions instead of contradicting
// them. Pairs with KNOWN-HAZARDS.md: hazards say "don't repeat this break",
// decisions say "here's why the code is the way it is". `ref` is stamped with
// the PR/commit once the change lands (pushSelfDevToGithub / mergeSelfDevPr).
model SelfDevDecision {
  id            String   @id @default(uuid())
  created_by_id String
  user          User     @relation(fields: [created_by_id], references: [id], onDelete: Cascade)
  project_id    String
  project       Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)

  summary       String   @db.Text // what changed
  rationale     String   @db.Text // why
  ref           String?            // PR #N or commit sha, stamped on land

  created_date  DateTime @default(now())

  @@index([project_id, created_date])
  @@map("self_dev_decisions")
}

// AI-synthesized "MORPHEUS UPDATES PLAN" — admin-only, ranks all Feedback
// rows into a prioritized, actionable plan. base44's live version regens
// this on demand via a "SYNTHESIZE PLAN" button; mirrors RebuildDoc's
// single-row-per-admin upsert pattern above. Backend enforcement is via
// requireAdmin in functions.routes.js's ADMIN_FUNCTIONS set — not just a
// frontend route guard, unlike the older self-documentation functions
// (generateRebuildDoc et al.), which are frontend-gated only (known,
// flagged gap — see project notes).
model UpdatesPlan {
  id              String   @id @default(uuid())
  created_by_id   String
  user            User     @relation(fields: [created_by_id], references: [id], onDelete: Cascade)

  content         String   @db.Text // the synthesized plan, markdown
  feedback_count  Int      @default(0) // how many Feedback rows fed this run

  created_date    DateTime @default(now())
  updated_date    DateTime @updatedAt

  @@map("updates_plans")
}

// Admin-only "COST TRACKER" page (src/pages/CostTracker.jsx) — a running
// tally of what it actually costs to host and run Morpheus, checked by hand
// against each provider's billing dashboard (Netlify, domain registrar,
// Northflank, Supabase, the LLM key, Stripe, etc.) since nothing in this
// stack exposes a live billing API to poll. One row, upserted on save, same
// single-row-per-admin pattern as UpdatesPlan/RebuildDoc above. Reachable
// only via the ProtectedRoute adminOnly-guarded /cost-tracker route and the
// generic entity CRUD engine's owner-scoping (server/src/entities.js) — a
// non-admin visiting the route would only ever see/create their own empty
// row, never another user's figures.
model CostSnapshot {
  id            String   @id @default(uuid())
  created_by_id String
  user          User     @relation(fields: [created_by_id], references: [id], onDelete: Cascade)

  items         String   @db.Text // JSON array: [{service, category, monthly, annual, tier, flag, note}]
  summary       String?  @db.Text // free-text notes (watch-list items, pending confirmations, etc.)

  created_date  DateTime @default(now())
  updated_date  DateTime @updatedAt

  @@map("cost_snapshots")
}

// Media Library (2026-09-09) — a project's content assets (product photos,
// event posters, self-made ads, media). ZERO CUSTODY: Morpheus stores only
// the url + caption, never the bytes. `source:'url'` = the operator pasted a
// public link they host themselves; `source:'repo'` = uploaded from device
// and committed straight into the project's own GitHub repo
// (public/assets/*, via github.js createOrUpdateFile) — the buffer is never
// persisted anywhere in Morpheus. The coder gets the url list as context so
// it writes real <img src> instead of placeholders. See MediaPanel.jsx.
model ProjectAsset {
  id            String   @id @default(uuid())
  created_by_id String
  user          User     @relation(fields: [created_by_id], references: [id], onDelete: Cascade)
  project_id    String
  project       Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)

  name          String                       // operator-facing label
  kind          String   @default("image")   // image | video | audio | pdf | font | other
  source        String   @default("url")     // url | repo
  url           String                       // what the coder writes into the code ("/assets/x.jpg" for repo, absolute for url)
  preview_url   String?                      // resolvable URL for the panel thumbnail + preview build (raw.githubusercontent for repo assets)
  repo_path     String?                      // path in github_repo, for delete (repo source only)
  alt           String?
  width         Int?
  height        Int?
  size          Int?

  created_date  DateTime @default(now())

  @@index([project_id, created_date])
  @@map("project_assets")
}

// Connection to a Morpheus WordPress plugin on the operator's own site —
// { site URL, shared signing secret }. Lets the Store panel drive
// WooCommerce/content actions on the site through the plugin's /store
// endpoint, and (later) the deploy webhook. Secret encrypted at rest
// (src/crypto.js). One connection per (project, kind).
model PluginConnection {
  id             String   @id @default(uuid())
  created_by_id  String
  owner          User     @relation(fields: [created_by_id], references: [id], onDelete: Cascade)
  project_id     String
  project        Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)

  kind           String   @default("wordpress")
  site_url       String
  webhook_secret String   @db.Text          // encrypted at rest
  repo           String?                     // owner/repo the plugin's Deploy module targets, if set
  meta           String?  @db.Text           // JSON — last status, cached context, etc.

  created_date   DateTime @default(now())
  updated_date   DateTime @updatedAt

  @@unique([project_id, kind])
  @@map("plugin_connections")
}

// An embeddable-widget access token — lets a slim Morpheus surface embedded
// on the owner's own site act as the owner, but scoped to ONE project and a
// fixed set of actions. The full token (wgt_<hex>) is shown once at
// creation; only its SHA-256 is stored. See the "Self-Dev as a Plugin"
// scope doc, §"The chat surface".
model WidgetToken {
  id            String    @id @default(uuid())
  created_by_id String
  owner         User      @relation(fields: [created_by_id], references: [id], onDelete: Cascade)
  project_id    String
  project       Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)

  token_prefix  String    // "wgt_" + first 8 chars — for display in the token list
  token_hash    String    @unique // sha256(full token)
  label         String?
  scopes        String    @default("chat,deploy,store") // comma-separated
  revoked       Boolean   @default(false)
  last_used_at  DateTime?

  created_date  DateTime  @default(now())

  @@index([project_id])
  @@map("widget_tokens")
}

// ── MORPHEUS CONNECT — device login for native/compiled apps ──────
// A distributable .exe (e.g. Construct's Wikidata Batch Uploader) can't
// hold a per-user session, and must never embed a static secret tied to
// whoever built it (anyone running the binary would spend that person's
// credits). Device flow instead: the app gets a short code, the end user
// approves it in their own browser while logged into their own account,
// the app polls until it gets back a DeviceToken scoped to exactly one
// narrow capability (see lib/deviceToken.js's DEVICE_SCOPE_FUNCTIONS) and
// billed against that end user's own credits via the normal invokeAI path.
// Mirrors WidgetToken's hash-at-rest/revocable shape, but personal (no
// project_id) rather than per-project, and reached via a public
// start/poll flow rather than an already-authenticated session, since
// Morpheus itself — not an external device-code holder like GitHub in the
// existing GitHub Device Flow — is the authority here.
model DeviceAuthRequest {
  id              String    @id @default(uuid())
  device_code     String    @unique // long opaque secret, exe polls with this
  user_code       String    @unique // short human code, shown on /connect
  client_label    String    // "Wikidata Batch Uploader" — shown on the approval screen
  scopes          String    // comma-separated, e.g. "ai_action"
  status          String    @default("pending") // pending | approved | denied | expired
  approved_by_id  String?
  issued_token_id String?   // set once a DeviceToken is minted on approval
  pending_token   String?   // plaintext secret, held only until the app's next
                            // poll reads and clears it — the durable DeviceToken
                            // row only ever stores the hash; this is the one-time
                            // relay from "approved in a browser" to "the polling
                            // app finally sees the real token"

  expires_at      DateTime
  created_date    DateTime  @default(now())

  @@map("device_auth_requests")
}

model DeviceToken {
  id            String    @id @default(uuid())
  created_by_id String    // the end user who approved it — the billing/identity anchor
  user          User      @relation(fields: [created_by_id], references: [id], onDelete: Cascade)

  label         String    // client_label, carried over for a future "connected apps" list
  token_prefix  String    // "dvc_" + first 8 chars — for display only
  token_hash    String    @unique // sha256(full token)
  scopes        String    // comma-separated
  revoked       Boolean   @default(false)
  last_used_at  DateTime?

  created_date  DateTime  @default(now())

  @@index([created_by_id])
  @@map("device_tokens")
}
