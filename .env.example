# Client-side configuration. Copy to `.env` for local development.
#
# EVERY VARIABLE IN THIS FILE IS PUBLIC. Vite inlines anything prefixed `VITE_` into the browser bundle,
# so these values are readable by anyone who loads the site — that is what the prefix means, and it is why
# `netlify.toml` omits exactly these keys from Netlify's secrets scan (read the comment there for the hour
# it cost to work out). **Never put a credential in a VITE_ variable.** The build will not stop you;
# `scripts/verify-client-env.mjs` fails on a secret-shaped name, and the scanner must stay on for
# everything else.

# Where the client sends API calls. `/api` means same-origin, which is right for a local server; a deployed
# instance points this at its own API host.
VITE_API_BASE_URL=/api

# Google sign-in. Defaults to ON, so only the exact string "false" disables it — used where the OAuth
# redirect URI cannot be registered yet.
VITE_GOOGLE_AUTH_ENABLED=true

# Ported Base44 client parameters. Empty is the correct value for a self-hosted instance.
VITE_BASE44_APP_ID=
VITE_BASE44_APP_BASE_URL=
VITE_BASE44_FUNCTIONS_VERSION=
